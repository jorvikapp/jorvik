{
  "appId": "app.jorvik.desktop",
  "productName": "Jorvik",
  "icon": "build/icon.png",
  "asar": true,
  "asarUnpack": "**/*.node",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "dist/electron/**/*",
    "web/**/*",
    "package.json",
    "build/**/*"
  ],
  "extraResources": [
    {
      "from": "../web/public/jorvik-icon.png",
      "to": "jorvik.png"
    }
  ],
  "afterPack": "scripts/electron-builder-after-pack.cjs",
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "category": "public.app-category.social-networking",
    "extendInfo": {
      "NSCameraUsageDescription": "Jorvik uses your camera for video in calls and voice channels.",
      "NSMicrophoneUsageDescription": "Jorvik uses your microphone for calls and voice channels."
    },
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "strictVerify": false,
    "identity": null,
    "mergeASARs": true
  },
  "dmg": {}
}
