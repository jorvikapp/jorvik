{
  "appId": "app.jorvik.desktop",
  "productName": "Jorvik",
  "icon": "build/icon.png",
  "asar": true,
  "asarUnpack": "**/*.node",
  "electronFuses": {
    "runAsNode": false,
    "enableCookieEncryption": true,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true,
    "grantFileProtocolExtraPrivileges": false,
    "loadBrowserProcessSpecificV8Snapshot": false,
    "resetAdHocDarwinSignature": true
  },
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "dist/electron/**/*",
    "web/**/*",
    "package.json",
    "build/**/*",
    "!build/tray-badges/**",
    "!build/icons/**"
  ],
  "extraResources": [
    {
      "from": "../web/public/jorvik-icon.png",
      "to": "jorvik.png"
    },
    {
      "from": "build/tray-badges",
      "to": "tray-badges"
    }
  ],
  "afterPack": "scripts/electron-builder-after-pack.cjs",
  "win": {
    "target": [
      "nsis"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "category": "public.app-category.social-networking",
    "hardenedRuntime": true,
    "gatekeeperAssess": true,
    "strictVerify": true,
    "entitlements": "electron/entitlements.mac.plist",
    "entitlementsInherit": "electron/entitlements.mac.plist",
    "mergeASARs": true
  },
  "dmg": {},
  "linux": {
    "icon": "build/icons",
    "desktop": {
      "entry": {
        "Name": "Jorvik",
        "Comment": "Jorvik Desktop Client",
        "Icon": "jorvik",
        "Terminal": "false",
        "Type": "Application",
        "StartupWMClass": "jorvik"
      }
    },
    "target": [
      "AppImage",
      "deb",
      "rpm",
      "tar.gz"
    ],
    "category": "Network;Chat;",
    "executableName": "jorvik",
    "artifactName": "Jorvik-${version}.${ext}"
  },
  "deb": {
    "maintainer": "Jorvik contributors <admin@jorvik.app>"
  },
  "rpm": {
    "packageName": "jorvik"
  }
}
